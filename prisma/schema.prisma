// The Truth Pill — Prisma schema (Phase 00/01 draft)
//
// PORTED FROM: web/convex/schema.ts — FROZEN, read-only, never edited.
// Every type decision below is justified by a production export taken with
// `npx convex export --prod` on 2026-09-26. Evidence lives in
// docs/phases/phase-00/data-migration-findings.md.
//
// ── Prisma 7 + Neon (ADR-003, ADR-004) ────────────────────────────────────────
// * No `url` in the datasource block. Prisma 7 reads the connection string from
//   api/prisma.config.ts. The `provider` line is still REQUIRED or native types
//   such as @db.Uuid and @db.Timestamptz(3) are rejected.
// * DO NOT put `url` back in this file. DO NOT run `migrate dev` against Neon.
//
// ── Two deliberate departures from Convex ─────────────────────────────────────
// 1. Relations that Convex stores as bare strings or implicit ids are real
//    foreign keys here. Postgres enforces them; Convex never did. See DEV-023
//    (articles.pillar -> pillars.slug) and DEV-025 (id relations gain
//    ON DELETE CASCADE, which Convex had no equivalent of).
// 2. Counter columns that Convex lets drift are marked in the model. The import
//    recomputes them from their source tables — see DEV-021 and DEV-022.
//
// ── What is NOT modelled ─────────────────────────────────────────────────────
// Convex's implicit `_creationTime` is dropped. It is not declared in
// schema.ts, no Convex function reads it, and every model here carries a real
// `createdAt` where one is meaningful. Porting it would import a storage
// artefact, not a contract.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ═══════════════════════════════════════════════════════════════════════════
// ENUMS
//
// A `v.union(v.literal(...))` becomes a native Postgres enum. Every enum below
// lists ALL values declared in schema.ts, including values the production data
// has never used — an enum is a contract, and narrowing it to observed data
// would reject the first article typed `observant` or the first `insightful`
// reaction.
// ═══════════════════════════════════════════════════════════════════════════

/// 2 declared, 2 observed (admin, user).
enum UserRole {
  admin
  user
}

/// 3 declared, 2 observed (published, draft). `scheduled` is live: the
/// `publish-scheduled-articles` cron publishes rows in this state.
enum ArticleStatus {
  draft
  scheduled
  published
}

/// 2 declared, 2 observed.
enum ArticleSource {
  human
  ai
}

/// 5 declared, 4 observed. `observant` is unused in production but declared.
enum ArticleType {
  pillar
  cluster
  micro
  insight
  observant
}

/// 3 declared, 2 observed. `insightful` is declared but unused.
enum ReactionType {
  like
  love
  insightful
}

/// 4 declared, 0 observed — the comments table is empty in production.
enum CommentStatus {
  approved
  pending
  spam
  removed
}

/// 4 declared, 1 observed (all 4 queued rows are `sent`).
enum EmailQueueStatus {
  pending
  sending
  sent
  failed
}

/// 2 declared, 1 observed (all 5 rows are `pending`).
enum ResearchTopicStatus {
  pending
  processed
}

/// 2 declared, 0 observed — the otpCodes table is empty in production.
enum OtpCodeType {
  password_reset
  password_change
}

/// 2 declared, 0 observed.
enum AiTestStatus {
  success
  failed
}

// ═══════════════════════════════════════════════════════════════════════════
// SINGLETONS
//
// Four Convex tables are read with `.first()` and have no natural key:
//   globalStats  — web/convex/admin.ts:15, web/convex/stats.ts:9,79
//   siteSettings — web/convex/site_settings.ts:7,51
//   adsSettings  — web/convex/ads.ts:10,55
//   aiSettings   — web/convex/ai.ts:8,21,37
//
// A random uuid primary key would make `upsert` non-deterministic and break the
// idempotency ADR-008 requires. These get fixed literal ids so the import is
// `upsert({ where: { id: "global_stats" } })` and re-running is a no-op.
//
// `aiSchedule` is NOT a singleton: web/convex/ai.ts:103 collects the table.
// ═══════════════════════════════════════════════════════════════════════════

/// Denormalised counters, read by web/convex/admin.ts:15 to avoid table scans.
///
/// ⚠️ STALE BY CONSTRUCTION — see DEV-022. The stored values drifted +3 on
/// articleCount/publishedArticleCount and +3,274 on totalViews. Causes:
///   * deleteForever (web/convex/articles.ts:911) and bulkDeleteForever
///     (web/convex/articles.ts:1063) decrement through a DEFERRED
///     `ctx.scheduler.runAfter(0, ...)`, so the decrement is not atomic with the
///     delete and is lost if the scheduled mutation has not drained.
///   * purgeOldAnalytics (web/convex/analytics_cleanup.ts:25) deletes pageVisits
///     rows older than 90 days and NEVER decrements totalViews, so that counter
///     can only ever grow.
/// The import recomputes all ten from the source tables inside one transaction.
model GlobalStats {
  id String @id @default("global_stats")

  articleCount          Int @default(0)
  publishedArticleCount Int @default(0)
  draftArticleCount     Int @default(0)
  scheduledArticleCount Int @default(0)
  aiDraftCount          Int @default(0)
  usersCount            Int @default(0)
  commentsCount         Int @default(0)
  pendingCommentsCount  Int @default(0)
  totalViews            Int @default(0)
  totalUniqueViews      Int @default(0)

  /// Not in Convex. A recomputed cache row with no timestamp is unauditable.
  /// Additive only — never a request or response discriminator.
  updatedAt DateTime @default(now()) @db.Timestamptz(3)

  @@map("globalStats")
}

/// The 20th table. `web/convex/schema.ts:18-37`.
model User {
  id String @id @default(uuid(7)) @db.Uuid

  name                 String
  email                String    @unique @db.VarChar(320)
  /// bcrypt, copied VERBATIM from Convex. Never re-hashed — re-hashing
  /// invalidates every existing login (AGENTS.md, deviations.md "Non-deviations").
  /// VarChar(60) is the exact and only length bcrypt produces; an over-length
  /// value is rejected by Postgres rather than silently truncated into an
  /// unmatchable hash. Switching hash algorithms requires a migration.
  password             String?   @db.VarChar(60)
  profileImage         String?
  /// Free text, NOT an enum. The export holds three values — `email`, `guest`,
  /// `system` — which is wider than the `google/email` pair the schema comment
  /// assumes. An enum here fails the import on the first guest row.
  provider             String
  role                 UserRole
  /// Declared in schema.ts but set on 0 of 5 production rows. Kept: the field is
  /// part of the contract and Phase 03 auth writes it.
  emailVerified        Boolean?
  /// Never set in production (0 of 5). Kept for the same reason.
  newsletterSubscribed Boolean   @default(false)
  emailConfirmed       Boolean?
  confirmationToken    String?
  resetToken           String?
  resetTokenExpires    DateTime? @db.Timestamptz(3)
  /// Max 2 items in the export.
  completedTours       String[]
  createdAt            DateTime  @db.Timestamptz(3)

  articles        Article[]
  comments        Comment[]
  reactions       Reaction[]
  bookmarks       Bookmark[]
  pageVisits      PageVisit[]
  articleViews    ArticleView[]
  visitorTracking VisitorTracking[]

  @@index([role])
  @@index([confirmationToken])
  @@index([resetToken])
  @@map("users")
}

/// `web/convex/schema.ts:39-44`. 0 rows in production; the model is required
/// because 6 Convex functions read it.
model Quote {
  id String @id @default(uuid(7)) @db.Uuid

  text      String
  author    String
  category  String?
  createdAt DateTime @db.Timestamptz(3)

  @@index([createdAt(sort: Desc)])
  @@map("quotes")
}

/// `web/convex/schema.ts:46-97`. The largest table: 132 rows.
model Article {
  id String @id @default(uuid(7)) @db.Uuid

  title             String
  /// Public URL segment (`/[slug]`). MUST stay byte-identical (AGENTS.md rule 6).
  /// Export max length 172, all ASCII, `[a-z0-9-]` only, 0 duplicates across
  /// 132 rows — so this is @unique, not merely indexed. A duplicate here 404s a
  /// live URL and costs organic traffic.
  slug              String        @unique @db.VarChar(255)
  excerpt           String?
  /// Rich text. Export max length 19,558 — Text, not VarChar.
  content           String?
  coverImage        String?
  coverImageAlt     String?
  authorId          String        @db.Uuid
  categoryId        String?       @db.Uuid
  /// Pillar slug. Convex stores a bare string and never checks it, which is how
  /// 5 published articles came to reference 2 slugs that do not exist.
  /// Now a real FK — see DEV-023.
  pillar            String?       @db.VarChar(255)
  /// Single topic, kept as an array for back-compat. Max 1 item in the export.
  topics            String[]
  /// Cross-cutting tags. Max 24 items in the export.
  tags              String[]
  type              ArticleType?
  status            ArticleStatus
  source            ArticleSource
  scheduledFor      DateTime?     @db.Timestamptz(3)
  publishedAt       DateTime?     @db.Timestamptz(3)
  viewCount         Int           @default(0)
  uniqueViewCount   Int           @default(0)
  /// ⚠️ STALE — see DEV-021. 3 articles carry the field and all three are 0,
  /// while 4 reactions exist across 4 other articles. The import recomputes it
  /// from the reactions table, which is append-only and never purged.
  reactionsCount    Int?
  /// Estimated minutes. Max 16 in the export.
  readingTime       Int
  /// Total seconds spent by all readers. `Int`, not BigInt: max 3,360 s today and
  /// Int holds 2.1e9 seconds — about 68 years of accumulated reading time.
  actualReadingTime Int?
  metaTitle         String?
  metaDescription   String?
  focusKeyword      String?
  createdAt         DateTime      @db.Timestamptz(3)
  updatedAt         DateTime      @db.Timestamptz(3)
  isFeatured        Boolean?
  isArchived        Boolean?

  /// Populated by the `0001_search` SQL migration, not by Prisma. Kept
  /// `Unsupported` so Prisma can see the column and generate a client for it
  /// while owning neither its expression nor its index. See the search section
  /// of data-migration-findings.md before writing that migration.
  searchVector Unsupported("tsvector")?

  author       User          @relation(fields: [authorId], references: [id], onDelete: Restrict)
  category     Category?     @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  pillarRef    Pillar?       @relation(fields: [pillar], references: [slug], onDelete: SetNull)
  comments     Comment[]
  reactions    Reaction[]
  bookmarks    Bookmark[]
  articleViews ArticleView[]

  @@index([status])
  @@index([publishedAt(sort: Desc)])
  @@index([categoryId])
  @@index([authorId])
  @@index([status, categoryId])
  @@index([pillar])
  @@map("articles")
}

/// `web/convex/schema.ts:99-107`. `slug` is a public URL segment.
model Category {
  id String @id @default(uuid(7)) @db.Uuid

  name         String
  slug         String   @unique @db.VarChar(255)
  description  String?
  coverImage   String?
  /// Max 5 items in the export.
  pexelsImages String[]
  /// ⚠️ STALE — recomputed at import. Stored sum 135 vs actual 132, with the
  /// whole +3 landing on a single category. Same root cause as DEV-022:
  /// the delete paths adjust this through a deferred scheduled mutation.
  articleCount Int      @default(0)
  createdAt    DateTime @db.Timestamptz(3)

  articles       Article[]
  pillars        Pillar[]
  researchTopics ResearchTopic[]

  @@map("categories")
}

/// `web/convex/schema.ts:109-124`. 0 rows in production.
///
/// `parentId` is self-referencing, so the import is TWO-PASS: insert every row
/// with `parentId = NULL`, then resolve with a single `UPDATE ... FROM` against
/// the persisted id map (ADR-008). Ordered inserts fail at arbitrary nesting
/// depth. The table is empty today, so this path is untested against real data
/// and MUST be tested with a synthetic fixture before Phase 02 signs off.
model Comment {
  id String @id @default(uuid(7)) @db.Uuid

  articleId String        @db.Uuid
  userId    String        @db.Uuid
  parentId  String?       @db.Uuid
  content   String
  status    CommentStatus
  createdAt DateTime      @db.Timestamptz(3)

  article Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  parent  Comment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: Cascade)
  replies Comment[] @relation("CommentReplies")

  @@index([articleId])
  @@index([userId])
  @@index([parentId])
  @@map("comments")
}

/// `web/convex/schema.ts:126-139`.
///
/// The unique key is (articleId, userId) and NOT (articleId, userId, type):
/// web/convex/engagement.ts:87-92 looks the pair up with `.unique()` and PATCHES
/// the type on an existing row (line 104). A three-column unique would permit
/// two rows for one pair and make that `.unique()` throw at runtime. The
/// production data satisfies both candidates (4 rows, 4 distinct pairs), so the
/// code — not the data — is what settles this.
model Reaction {
  id String @id @default(uuid(7)) @db.Uuid

  articleId String       @db.Uuid
  userId    String       @db.Uuid
  type      ReactionType
  createdAt DateTime     @db.Timestamptz(3)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([articleId, userId])
  @@index([userId])
  @@index([createdAt])
  @@map("reactions")
}

/// `web/convex/schema.ts:141-145`. `.unique()` on the pair at
/// web/convex/engagement.ts:135-141, so the pair is genuinely unique.
model Bookmark {
  id String @id @default(uuid(7)) @db.Uuid

  articleId String   @db.Uuid
  userId    String   @db.Uuid
  createdAt DateTime @db.Timestamptz(3)

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, articleId])
  // Not in Convex. `ON DELETE CASCADE` on articleId scans this table per deleted
  // article; in Convex that scan was implicit and free. Without this index the
  // move to Postgres makes article deletion strictly slower than the legacy.
  @@index([articleId])
  @@map("bookmarks")
}

/// `web/convex/schema.ts:147-167`. 2,009 rows, but only a 90-day window:
/// purgeOldAnalytics (web/convex/analytics_cleanup.ts:13) deletes everything
/// older. Retain the same policy in the Phase 07 cleanup job.
model PageVisit {
  id String @id @default(uuid(7)) @db.Uuid

  visitorId   String   @db.Uuid
  /// Optional in schema.ts, unset on 2,009 of 2,009 production rows. Kept —
  /// web/convex/users.ts:118-132 queries it for logged-in visitor attribution.
  userId      String?  @db.Uuid
  url         String   @db.VarChar(2048)
  /// ⚠️ Text, deliberately NOT `inet`. See DEV-024. The value is the raw,
  /// unparsed `x-forwarded-for` header (web/app/actions/analytics.ts:27), which
  /// is client-controlled and may be a comma-separated list or IPv6. The admin
  /// UI also compares it to the literal sentinel "127.0.0.1"
  /// (web/app/admin/analytics/page.tsx:312,572), so the stored text must survive
  /// verbatim. VarChar(45) is the longest possible IPv6 text form, and the
  /// longest value in the export is 15 characters, so the limit costs nothing.
  ipAddress   String   @db.VarChar(45)
  /// Keys are exactly {city, country} across all 86 populated rows; max length 13.
  /// Kept as Json, not flattened: web/convex/analytics.ts:404 returns the stored
  /// object verbatim in the getRawVisits response, so flattening columns would
  /// change the API response shape. The API DTO types it as
  /// { country?: string; city?: string } independently of the storage type.
  geoLocation Json?
  device      String
  browser     String
  os          String
  referrer    String?
  timestamp   DateTime @db.Timestamptz(3)

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([visitorId])
  @@index([userId])
  @@index([url])
  @@index([timestamp(sort: Desc)])
  @@map("pageVisits")
}

/// `web/convex/schema.ts:169-177`. 3,240 rows, never purged.
///
/// `trackingCode` is the canonical visitor identity and the import's idempotency
/// key, so it is @unique. Generated by `crypto.randomUUID()` at
/// web/lib/analytics.ts:6 — and 3,240 of 3,240 production values are 36-character
/// RFC-4122 UUIDs, which is what justifies the native `uuid` column.
model VisitorTracking {
  id String @id @default(uuid(7)) @db.Uuid

  trackingCode String   @unique @db.Uuid
  userId       String?  @db.Uuid
  firstVisit   DateTime @db.Timestamptz(3)
  lastVisit    DateTime @db.Timestamptz(3)
  totalVisits  Int      @default(0)
  user         User?    @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("visitorTracking")
}

/// `web/convex/schema.ts:179-184`. 103 rows, one per day that had traffic.
///
/// `date` is a `YYYY-MM-DD` UTC string in Convex and an index-ordered range scan
/// in web/convex/analytics.ts:152-157. All 103 values match `^\d{4}-\d{2}-\d{2}$`
/// and parse as real dates, so a native `date` column is safe and lets the range
/// predicate become index-native instead of a string comparison.
///
/// NOT purged, unlike pageVisits. Its 103 rows span 2026-05-10 → 2026-09-26 and
/// sum to 2,429 visits against 2,009 retained raw rows — the 420 difference is
/// the days whose raw rows were already purged. That asymmetry is expected, not
/// corruption, and it is the reason globalStats.totalViews is recomputed from
/// this table rather than from pageVisits (DEV-022).
model DailyStat {
  id String @id @default(uuid(7)) @db.Uuid

  date           DateTime  @unique @db.Date
  visits         Int
  uniqueVisitors Int
  /// Watermark: timestamp of the last pageVisit folded in (web/convex/rollup.ts:32).
  lastRollup     DateTime? @db.Timestamptz(3)

  @@map("dailyStats")
}

/// `web/convex/schema.ts:186-194`. 1 row. Not a singleton — collected at
/// web/convex/ai.ts:103. Idempotency key for the import is
/// (daysOfWeek, time, timezone).
model AiSchedule {
  id String @id @default(uuid(7)) @db.Uuid

  /// [0-6]. Observed: 0, 1, 3, 6.
  daysOfWeek       Int[]
  /// HH:MM
  time             String
  timezone         String
  isActive         Boolean   @default(false)
  lastRun          DateTime? @db.Timestamptz(3)
  topicsToResearch String[]
  nextRun          DateTime? @db.Timestamptz(3)

  @@map("aiSchedule")
}

/// `web/convex/schema.ts:196-206`. 1 row. Read with `.first()` (web/convex/ai.ts:8).
model AiSettings {
  id String @id @default("ai_settings")

  /// Free text. The single production row says `gemini`, which is not among the
  /// `openai, anthropic, deepseek` examples in the schema comment.
  provider       String
  /// ⚠️ NULLABLE ON PURPOSE — DEV-015. This holds a LIVE PLAINTEXT third-party
  /// API key: web/convex/ai.ts:23 patches args.apiKey into the document raw, and
  /// the export value is a 39-char Google-format key, not ciphertext. (This
  /// corrects AGENTS.md and the original DEV-015, which both claimed it was
  /// encrypted and undecryptable outside Convex. It is not.)
  ///
  /// The import writes NULL anyway — not because the value is unreadable, but
  /// because copying a live secret through a migration pipeline would push it
  /// into transform logs, quarantine files, and target backups. The operator
  /// re-enters it in Phase 08 AND rotates it at the provider. Making the column
  /// nullable is what guarantees an empty key can never be mistaken for a
  /// working one.
  apiKey         String?
  model          String
  promptTemplate String?
  isActive       Boolean       @default(false)
  lastTested     DateTime?     @db.Timestamptz(3)
  testStatus     AiTestStatus?
  isWriting      DateTime?     @db.Timestamptz(3)
  createdAt      DateTime?     @db.Timestamptz(3)

  @@map("aiSettings")
}

/// `web/convex/schema.ts:208-214`. 308 rows.
///
/// The (articleId, visitorId) pair is unique by construction: web/convex/analytics.ts:87-92
/// and :339-344 both resolve it with `.unique()`. All 308 production pairs are
/// distinct.
///
/// ⚠️ ONE ROW IN THE EXPORT REFERENCES AN ARTICLE THAT IS ABSENT FROM THE ENTIRE
/// EXPORT. Postgres cannot store that with a real FK. Import policy is a
/// quarantine record, not a silent drop — see the import-policy table in
/// docs/phases/phase-00/data-migration-findings.md.
///
/// No FK to visitorTracking.trackingCode: 20 of the 308 visitorIds have no
/// tracking row, so the relation does not hold.
model ArticleView {
  id String @id @default(uuid(7)) @db.Uuid

  articleId      String   @db.Uuid
  visitorId      String   @db.Uuid
  userId         String?  @db.Uuid
  viewedAt       DateTime @db.Timestamptz(3)
  /// Total seconds for this session. Max 2,880 in the export.
  engagementTime Int?

  article Article @relation(fields: [articleId], references: [id], onDelete: Cascade)
  user    User?   @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([articleId, visitorId])
  @@index([userId])
  @@map("articleViews")
}

/// `web/convex/schema.ts:216-231`. 4 rows, all `sent`.
model EmailQueue {
  id String @id @default(uuid(7)) @db.Uuid

  recipient    String           @db.VarChar(320)
  subject      String
  templateName String
  /// v.any() in Convex — a permissiveness bug (ADR-010) that is NOT ported. The
  /// column is Json because the shape is per-template; the API DTO validates it
  /// per template instead. Observed keys across the 4 rows: name, siteUrl,
  /// confirmUrl, unsubscribeUrl.
  templateData Json
  status       EmailQueueStatus
  scheduledFor DateTime         @db.Timestamptz(3)
  sentAt       DateTime?        @db.Timestamptz(3)
  error        String?
  retries      Int              @default(0)

  @@index([status, scheduledFor])
  @@map("emailQueue")
}

/// `web/convex/schema.ts:232-237`. 5 rows, all `pending`.
model ResearchTopic {
  id String @id @default(uuid(7)) @db.Uuid

  topic      String
  categoryId String?             @db.Uuid
  status     ResearchTopicStatus
  createdAt  DateTime            @db.Timestamptz(3)

  category Category? @relation(fields: [categoryId], references: [id], onDelete: SetNull)

  @@index([status])
  @@map("researchTopics")
}

/// `web/convex/schema.ts:239-247`. 0 rows. Singleton by `.first()`
/// (web/convex/ads.ts:10) — `adsEnabled` decides whether the frontend reads it
/// at all, so an absent row and a disabled row are different states.
model AdsSettings {
  id String @id @default("ads_settings")

  adsEnabled            Boolean  @default(false)
  adsenseScriptCode     String
  adsenseAdUnitCode     String
  showAdTopOfArticle    Boolean  @default(false)
  showAdMiddleOfArticle Boolean  @default(false)
  showAdBottomOfArticle Boolean  @default(false)
  showAdSidebar         Boolean  @default(false)
  updatedAt             DateTime @db.Timestamptz(3)

  @@map("adsSettings")
}

/// `web/convex/schema.ts:249-267`. 1 row. Singleton by `.first()`
/// (web/convex/site_settings.ts:7).
model SiteSettings {
  id String @id @default("site_settings")

  siteName        String
  siteDescription String
  email           String
  phone           String?
  address         String?
  /// Nested object with 7 optional keys. Kept as Json so the response shape
  /// matches Convex byte for byte — this whole document is returned to the
  /// client as-is. The DTO types it as 7 optional strings.
  socials         Json
  footerText      String?
  updatedAt       DateTime @db.Timestamptz(3)

  @@map("siteSettings")
}

/// `web/convex/schema.ts:268-276`. 0 rows.
///
/// `code` is deliberately NOT unique: OTP codes expire, so two live rows sharing
/// a value is legitimate and a unique constraint would reject the insert. The
/// Phase 08 cleanup job deletes expired rows.
model OtpCode {
  id String @id @default(uuid(7)) @db.Uuid

  email     String      @db.VarChar(320)
  code      String      @db.VarChar(32)
  type      OtpCodeType
  expiresAt DateTime    @db.Timestamptz(3)

  // Replaces Convex's two indexes: a btree on (email, type) already serves
  // `WHERE email = ?`, so the single-column index was redundant.
  @@index([email, type])
  @@index([code])
  @@map("otpCodes")
}

/// `web/convex/schema.ts:278-288`. 30 rows.
model Pillar {
  id String @id @default(uuid(7)) @db.Uuid

  name         String
  /// Public URL segment. 0 duplicates across 30 rows.
  slug         String   @unique @db.VarChar(255)
  description  String?
  coverImage   String?
  /// Declared on the model, never populated in production (max 0 items).
  pexelsImages String[]
  categoryId   String   @db.Uuid
  createdAt    DateTime @db.Timestamptz(3)

  category Category  @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  /// The reverse side of the DEV-023 FK. `articles.pillar` stores a slug, not an
  /// id, so this relation joins on a unique non-id column.
  articles Article[]

  @@index([categoryId])
  @@map("pillars")
}
