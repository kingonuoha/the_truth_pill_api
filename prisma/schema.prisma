/// `web/convex/schema.ts:268-276`. 0 rows.
///
/// `code` is deliberately NOT unique: OTP codes expire, so two live rows sharing
/// a value is legitimate and a unique constraint would reject the insert. The
/// Phase 08 cleanup job deletes expired rows.
/// `code` is VARCHAR(128), not 32, to reserve width for a hash-at-rest encoding
/// (bcrypt 60 / Argon2) per §CN-1 R9 — see DEV-027. Convex still stores the
/// 6-digit plaintext, so Phase 02 imports it unchanged.
///
/// ⚠️ THIS TABLE IS NOT A FAITHFUL PORT. The four columns added below are the
/// §CN-1 S-027 remediation and have **no counterpart in the frozen Convex
/// schema** — see DEV-028 and the R1 atomicity warning at the column itself.
/// Nothing else about the table deviates.
model OtpCode {
  id String @id @default(uuid(7)) @db.Uuid

  email     String      @db.VarChar(320)
  code      String      @db.VarChar(128)
  type      OtpCodeType
  expiresAt DateTime    @db.Timestamptz(3)

  // ─────────────────────────────────────────────────────────────────────────
  // §CN-1 R1/R2/R3/R7 — Nest-only additions. NOT in web/convex/schema.ts.
  //
  // The frozen Convex table (schema.ts:268-276) is exactly the five columns
  // above. The four below were added to `schema.ts` on `staging` during Phase 00
  // (phase-00/auth-security-task.md:1511-1518) to patch S-027 — and never
  // committed, so Rule 10 froze the file without them and Phase 01 ported the
  // frozen source faithfully. Deviation, not parity gap: see DEV-028.
  //
  // `attempts` is NOT NULL DEFAULT 0 so existing and future rows are always
  // readable; the other three are nullable because "no lockout", "never resent"
  // and "not yet used" are three distinct states, and collapsing them into 0 /
  // epoch would make `lastSentAt` cooldown and `consumedAt` replay checks
  // unsound on rows that predate the column.
  //
  // ⚠️ R1 MUST BE WRITTEN AS AN ATOMIC RAW UPDATE, never findUnique → update.
  // Convex gave per-document serializability for free; Prisma does not, and at
  // READ COMMITTED a read-then-write is a lost update. Required shape:
  //   UPDATE "otpCodes" SET "attempts" = "attempts" + 1, "lockedUntil" = ...
  //   WHERE "id" = $1 RETURNING "attempts"
  // owed test: 100 concurrent failed verifications increment attempts by
  // exactly 100. See DEV-028 and phase-00/auth-security-task.md:1579-1607.
  // ─────────────────────────────────────────────────────────────────────────
  attempts    Int       @default(0)
  lockedUntil DateTime? @db.Timestamptz(3)
  lastSentAt  DateTime? @db.Timestamptz(3)
  consumedAt  DateTime? @db.Timestamptz(3)

  // Replaces Convex's two indexes: a btree on (email, type) already serves
  // `WHERE email = ?`, so the single-column index was redundant. §CN-1 R8
  // per-account throttling is served by the (email, type) prefix of this index.
  @@index([email, type])
  @@index([code])
  @@map("otpCodes")
}

