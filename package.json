{
  "name": "truth-pill-api",
  "version": "0.0.0",
  "private": true,
  "description": "The Truth Pill — NestJS backend. Phase 03: NestJS core skeleton (no auth, no domain modules).",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "build": "rimraf dist && tsc -p tsconfig.build.json",
    "start": "node dist/main.js",
    "start:worker": "node dist/main-worker.js",
    "start:dev": "ts-node src/main.ts",
    "seed:admin": "ts-node --transpile-only src/scripts/seed-admin.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test": "ts-node --transpile-only test/app.e2e.ts",
    "test:otp": "ts-node --transpile-only test/otp.e2e.ts",
    "test:content": "ts-node --transpile-only test/content.e2e.ts",
    "test:engagement": "ts-node --transpile-only test/engagement.e2e.ts",
    "test:analytics": "ts-node --transpile-only test/analytics.e2e.ts",
    "test:ai": "ts-node --transpile-only test/ai.e2e.ts",
    "test:emails": "ts-node --transpile-only test/emails.e2e.ts",
    "test:stream": "ts-node --transpile-only test/stream.e2e.ts",
    "test:jobs": "ts-node --transpile-only test/jobs.e2e.ts",
    "test:spec-security": "ts-node --transpile-only test/openapi-security.e2e.ts",
    "generate:openapi": "ts-node --transpile-only scripts/generate-openapi.ts",
    "generate:types": "openapi-typescript openapi.yaml -o ../docs/types/api.ts",
    "api:check": "node scripts/api-check.mjs",
    "db:validate": "prisma validate",
    "db:format": "prisma format",
    "db:generate": "prisma generate",
    "db:diff": "prisma migrate diff --from-empty --to-schema prisma/schema.prisma --script",
    "db:deploy": "prisma migrate deploy",
    "db:status": "prisma migrate status"
  },
  "dependencies": {
    "@nestjs/common": "^11.2.7",
    "@nestjs/config": "^4.0.4",
    "@nestjs/core": "^11.2.7",
    "@nestjs/platform-express": "^11.2.7",
    "@nestjs/schedule": "^6.1.3",
    "@nestjs/swagger": "^11.4.7",
    "@nestjs/throttler": "^6.7.1",
    "@prisma/adapter-neon": "^7.0.0",
    "@prisma/client": "^7.0.0",
    "bcryptjs": "^3.0.3",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.4",
    "nodemailer": "^6.10.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.5",
    "@types/express": "^5.0.6",
    "@types/js-yaml": "^4.0.9",
    "@types/node": "^22.10.2",
    "@types/nodemailer": "^6.4.24",
    "dotenv": "^17.0.0",
    "eslint": "^9.39.5",
    "globals": "^15.15.0",
    "js-yaml": "^4.3.2",
    "openapi-typescript": "^7.13.0",
    "prisma": "^7.0.0",
    "rimraf": "^6.1.3",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.71.0"
  }
}
