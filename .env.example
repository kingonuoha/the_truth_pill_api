# ============================================================
# TruthPill — api/ environment template
#
# ⚠️  PLACEHOLDERS ONLY. No real values. Safe to commit.
#     Copy to `.env` and fill in. `.env` is gitignored — never commit it.
#
#     This file serves BOTH the temporary Neon test database and the
#     eventual production database. Nothing about the variable NAMES
#     changes between them — only the values. That is deliberate: the
#     connection-string swap is the entire cutover.
#
#     NEVER put any of these behind a `NEXT_PUBLIC_` prefix. Those are
#     inlined into the client bundle and are public.
# ============================================================

# ---------- Node ----------
NODE_ENV=development
PORT=3001

# ---------- Database (Neon Postgres) ----------
# ⚠️ TWO URLs, AND THE DIFFERENCE IS LOAD-BEARING.
#
#   DATABASE_URL → the POOLED host. The hostname ends in `-pooler`.
#                    Runtime queries only, via @prisma/adapter-neon.
#                    The pooler cannot run DDL.
#
#   DIRECT_URL   → the DIRECT host. Same hostname WITHOUT `-pooler`.
#                    `prisma migrate deploy` ONLY. Never used at runtime.
#
# Using the pooled URL for migrations fails. Using the direct URL at
# runtime burns connections and defeats pooling under load.
#
#   Runtime:   pnpm/npm run start:dev
#   Migrate:   npx prisma migrate deploy
DATABASE_URL=
DIRECT_URL=

# Pooled, e.g. postgresql://user:pass@ep-xxx-pooler.us-east-2.aws.neon.tech/truthpill?sslmode=require
# Direct, e.g. postgresql://user:pass@ep-xxx.us-east-2.aws.neon.tech/truthpill?sslmode=require
#
# ⚠️ Neon free tier SUSPENDS compute after ~5 min idle. Fine for
#    request/response. NOT fine for a long-lived pooled WebSocket — if the
#    worker holds one, it needs a keepalive or a non-suspending branch.

# ---------- Auth ----------
# Signs the JWTs the web tier verifies. MUST match web/.env AUTH_SECRET
# exactly, or every request fails verification in Phase 10.
# Generate: openssl rand -base64 32
AUTH_SECRET=

# Key for the HMAC-SHA256 OTP hash-at-rest (§CN-1 R9 / DEV-027). Falls back to
# AUTH_SECRET when unset, and THROWS at boot in production when neither is set.
# Never put this behind a NEXT_PUBLIC_ prefix.
# Generate: openssl rand -hex 32
OTP_HASH_SECRET=

# Public site URL used in OTP email template data. No trailing slash.
SITE_URL=https://thetruthpill.org

# ---------- CORS ----------
# Exact web origins, comma-separated. No trailing slash.
# The `cors` package matches each entry as an EXACT origin string, so a glob
# such as `https://truth-pill-*.vercel.app` will never match a real preview URL.
# List a stable alias per environment instead (e.g. the project's staging or
# production domain):
#   CORS_ORIGIN=https://www.thetruthpill.org,https://staging.thetruthpill.org
# Per-deploy ephemeral Vercel preview origins (`<project>-<hash>.vercel.app`)
# each need their own exact entry here, or the API must gain an explicit origin
# matcher — a deliberate decision that has not been taken yet.
CORS_ORIGIN=http://localhost:3000

# ---------- Internal jobs ----------
# Authenticates Render Cron and worker self-calls to /internal/*.
# Compared timing-safely. Never leave an /internal/* route unguarded.
# Generate: openssl rand -hex 32
INTERNAL_JOB_SECRET=
